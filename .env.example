# 币安期货API配置示例
# 复制此文件为 .env 并填入您的实际API密钥

# 单账户API密钥配置
BINANCE_FUTURES_API_KEY=your-actual-futures-api-key-here
BINANCE_FUTURES_API_SECRET=your-actual-futures-api-secret-here

# 双账户API配置
BINANCE_LONG_API_KEY=your-long-account-api-key
BINANCE_LONG_API_SECRET=your-long-account-api-secret
BINANCE_SHORT_API_KEY=your-short-account-api-key
BINANCE_SHORT_API_SECRET=your-short-account-api-secret

# 交易模式配置
TRADING_MODE=sandbox  # sandbox 为沙盒模式，live 为实盘模式

# 网格策略配置
STRATEGY_SIDE=long  # long 做多策略，short 做空策略
LEVERAGE=10         # 杠杆倍数 (1-125)
LOWER_PRICE=60000   # 网格下边界价格
UPPER_PRICE=70000   # 网格上边界价格
GRIDS=10           # 网格层数
ORDER_AMOUNT_USDT=100  # 每个网格订单的名义价值(USDT)
MAX_POSITION_COUNT=5   # 最大同时持仓的网格数量(风险控制)

# 前端配置
FRONTEND_ENABLED=true      # 是否启用WebSocket前端
FRONTEND_HOST=localhost:8080  # 前端服务地址

# 注意事项：
# 1. 请将此文件复制为 .env 并填入真实的API密钥
# 2. .env 文件不会被上传到Git仓库，确保API密钥安全
# 3. 建议先在沙盒模式下测试，确认无误后再切换到实盘模式
# 4. 根据当前市场价格调整 LOWER_PRICE 和 UPPER_PRICE
# 5. 建议从小金额开始测试 ORDER_AMOUNT_USDT
# 6. 双账户模式：多头账户和空头账户必须使用不同的API密钥
# 7. 两个账户都需要开启期货交易权限
